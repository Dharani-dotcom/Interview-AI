rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bharathidharani52@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Webinar Registrations
    match /webinarRegistrations/{registrationId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if true; // Allow candidates to submit webinar payment & registration
      allow update, delete: if isAdmin();
    }

    // Webinars
    match /webinars/{webinarId} {
      allow read: if true; // Publicly viewable upcoming webinars
      allow write: if isAdmin();
    }

    // Practice Questions (including DSA: Second Largest, Binary Search, Linear Search)
    match /practiceQuestions/{questionId} {
      allow read: if true; // Available for all candidates
      allow write: if isAdmin();
    }

    // Interview Reports
    match /interviewReports/{reportId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn() || true;
      allow update, delete: if isAdmin();
    }

    // Subscription Payments via QR Code
    match /subscriptionPayments/{paymentId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if true; // Allow candidates to submit their UPI payment proof / UTR
      allow update, delete: if isAdmin();
    }

    // User Usage and Quota Tracking
    match /userUsage/{userId} {
      allow read: if isSignedIn() || isAdmin() || true;
      allow create, update: if isSignedIn() || isOwner(userId) || isAdmin() || true;
      allow delete: if isAdmin();
    }
  }
}
