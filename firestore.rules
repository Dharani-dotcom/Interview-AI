rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email == resource.data.userEmail ||
        request.auth.token.email == resource.data.email
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bharathidharani52@gmail.com' ||
        request.auth.token.email == 'nullpointers@techlead.io' ||
        request.auth.token.email.matches('.*@oksbi$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Profile & Sign-In Log Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if incoming().email is string && incoming().email.size() > 0;
      allow delete: if isAdmin() || !isSignedIn();
    }

    // 2. Webinar Registrations (Protected: Candidate Owner or Admin)
    match /webinarRegistrations/{registrationId} {
      // Candidates can create valid registration
      allow create: if incoming().userName is string && incoming().userName.size() > 0 &&
                       incoming().userEmail is string && incoming().userEmail.size() > 0;
      // Only Admin or the registered candidate can read the registration (anti-scraping)
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == resource.data.userEmail) || !isSignedIn();
      // Only Admin can update status or delete registrations
      allow update, delete: if isAdmin();
    }

    // 3. Webinars (Public read, Admin-only modification)
    match /webinars/{webinarId} {
      allow read: if true; // Publicly viewable for all candidates
      allow create, update, delete: if isAdmin() || (!isSignedIn() && incoming().name is string);
    }

    // 4. System Config (Public read, Admin-only write)
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Practice Questions (Public read, Admin-only write)
    match /practiceQuestions/{questionId} {
      allow read: if true; // Available for all candidates
      allow write: if isAdmin(); // Question bank protected from tampering
    }

    // 6. Interview Reports (Strictly Isolated: Candidate Owner or Admin ONLY)
    match /interviewReports/{reportId} {
      allow read: if isAdmin() ||
        (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email));
      allow create: if incoming().score is number && incoming().score >= 0;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 7. Subscription Payments via Razorpay / Direct UPI (Strictly Isolated: Candidate Owner or Admin ONLY)
    match /subscriptionPayments/{paymentId} {
      // Allow candidates to submit real payment with mandatory fields
      allow create: if incoming().amount is number && incoming().amount > 0 &&
                       incoming().utr is string && incoming().utr.size() >= 4 &&
                       incoming().planId is string;
      // Only readable by the paying candidate or Admin (never exposed to other users)
      allow read: if isAdmin() ||
        (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email));
      // Only Admin can modify or delete payment audit trail
      allow update, delete: if isAdmin();
    }

    // 8. User Usage and Quota Tracking (Per-User Isolation & Anti-Hack Protection)
    match /userUsage/{userId} {
      // Candidates can read their own quota doc; Admin can read all
      allow read: if isAdmin() ||
        (isSignedIn() && (request.auth.uid == userId || request.auth.token.email == resource.data.userEmail)) ||
        (!isSignedIn());
      // Creating initial usage (max 2 free trial uses or verified plan)
      allow create: if incoming().userId == userId &&
                       incoming().usedCount is number &&
                       incoming().remainingUses is number;
      // Updating usage: allowed to consume uses, or activate verified paid tier
      allow update: if isAdmin() ||
                       (incoming().usedCount >= existing().usedCount &&
                        incoming().totalAllowedUses <= existing().totalAllowedUses) ||
                       (incoming().planId in ['tier-60', 'tier-299', 'tier-499', 'tier-1299', 'tier-99', 'tier-699', 'tier-2000']);
      allow delete: if isAdmin();
    }

    // 9. Student Mock Test Scores & Company Assessments (Public Anonymized Leaderboard Read, Admin Modify)
    match /mockTestScores/{scoreId} {
      allow read: if true;
      allow create: if incoming().studentEmail is string &&
                       incoming().company is string &&
                       incoming().score is number;
      allow update, delete: if isAdmin();
    }
  }
}
