rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bharathidharani52@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Webinar Registrations
    match /webinarRegistrations/{registrationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Webinars (Real-time synchronized across all devices globally)
    match /webinars/{webinarId} {
      allow read: if true; // Publicly viewable upcoming webinars for all users
      allow create, update, delete: if true; // Real-time admin management from all devices
    }

    // System Config & Global Metadatas
    match /systemConfig/{configId} {
      allow read, write: if true;
    }

    // Practice Questions (including DSA: Second Largest, Binary Search, Linear Search)
    match /practiceQuestions/{questionId} {
      allow read: if true; // Available for all candidates
      allow write: if true;
    }

    // Interview Reports
    match /interviewReports/{reportId} {
      allow read: if true;
      allow write: if true;
    }

    // Subscription Payments via QR Code (Allow read for candidate verification & admin review)
    match /subscriptionPayments/{paymentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // User Usage and Quota Tracking
    match /userUsage/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
